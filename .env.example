# =============================================================
# NEWA Zeiterfassung - Environment Variables
# Copy to .env and fill in the values
# =============================================================

# --- Application ---
APP_ENV=development
APP_HOST=localhost
APP_PORT=8080

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=zeiterfassung
DB_USER=zeit_app
DB_PASSWORD=
DB_SSLMODE=disable

# --- Session ---
SESSION_SECRET=
SESSION_MAX_AGE=86400

# --- Azure AD / Entra ID (Phase 2) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_APP_NAME=NEWA Zeiterfassung
